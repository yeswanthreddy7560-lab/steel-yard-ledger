rules_version = '2';

/* This catalogue is server-rendered and uses the Firebase Admin SDK, which
   bypasses security rules. No browser or mobile client talks to Firestore
   directly, so every client read/write is denied. */
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
